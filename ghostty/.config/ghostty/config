# Typography
# font-family = JetBrains Mono Nerd Font
font-family = Monoid Nerd Font
font-size = 13
font-thicken = true
adjust-cell-height = 1

# Aesthetics
window-padding-x = 0
window-padding-y = 0
# theme = Dracula
# theme = Catppuccin Frappe
# theme = Black Metal (Bathory)
# theme = Gruvbox Dark
# theme = Vague
theme = Cyberpunk Scarlet Protocol
background-opacity = 0.91
background-blur = 20
# background = #000000

# Feature config
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor   
keybind = ctrl+backspace=text:\x17
resize-overlay-duration = 4s 200ms
keybind = ctrl+|=new_split:right
keybind = ctrl+z=close_surface
