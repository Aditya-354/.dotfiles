# Typography
font-family = JetBrains Mono Nerd Font
# font-family = Monoid Nerd Font
# font-family = "Iosevka NFM Light"
# font-family = "Iosevka NFM"
# font-family = "Iosevka NFM ExtraLight"
font-size = 13
font-feature = -liga
# font-thicken = true
# adjust-cell-height = 0

# Aesthetics
window-padding-x = 0
window-padding-y = 0
# theme = Dracula
# theme = Catppuccin Frappe
# theme = Catppuccin Mocha
# theme = Black Metal (Bathory)
# theme = Gruvbox Dark
# theme = Gruvbox Material
# theme = Flexoki Dark
theme = Monokai Soda
# theme = Adventure
# theme = 3024 Night
# theme = Jellybeans
# theme = Nord
# theme = Cyberpunk Scarlet Protocol
background-opacity = 1
# background-opacity = 1
background-blur = 20
# background = #000000

# Feature config
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor   
keybind = ctrl+backspace=text:\x17
# resize-overlay-duration = 4s 200ms
keybind = ctrl+|=new_split:right
keybind = ctrl+z=close_surface
