layout {

    focus-ring {
        active-color   "#c9c9c9"
        inactive-color "#211c1c"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#c9c9c9"
        inactive-color "#211c1c"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#211c1c70"
    }

    tab-indicator {
        active-color   "#c9c9c9"
        inactive-color "#756a6a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#c9c9c980"
    }
}

recent-windows {
    highlight {
        active-color "#c9c9c9"
        urgent-color "#fd4663"
    }
}
