layout {

    focus-ring {
        active-color   "#b3989d"
        inactive-color "#211c1d"
        urgent-color   "#ff2d50"
    }

    border {
        active-color   "#b3989d"
        inactive-color "#211c1d"
        urgent-color   "#ff2d50"
    }

    shadow {
        color "#211c1d70"
    }

    tab-indicator {
        active-color   "#b3989d"
        inactive-color "#584145"
        urgent-color   "#ff2d50"
    }

    insert-hint {
        color "#b3989d80"
    }
}

recent-windows {
    highlight {
        active-color "#b3989d"
        urgent-color "#ff2d50"
    }
}
