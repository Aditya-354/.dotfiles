layout {

    focus-ring {
        active-color   "#eeb1ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#eeb1ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#eeb1ff"
        inactive-color "#652f79"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#eeb1ff80"
    }
}

recent-windows {
    highlight {
        active-color "#eeb1ff"
        urgent-color "#ffb4ab"
    }
}
