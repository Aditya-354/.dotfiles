// 1. data / time
// 2. media
// 3. network / ethernet
// 4. bluetooth
// 5. workspaces
// 6. volume
// 7. brightness

{
    "layer": "top",
    // "modules-left": ["sway/workspaces", "sway/mode"],
    "spacing": 20,
    // "margin-top": 5,
    "modules-left": [
        "hyprland/workspaces", 
        "hyprland/window",

    ],
    "modules-center": [
        "clock", 
    ],
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        // "custom/wallpaper",
        "network",
    ],
    // "modules-center": [
    // ],
    "clock": {
        "interval": 60,
        "format": " {:%A %d-%m-%Y %I:%M %p}",
        "tooltip": false,
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "eDP-1": 5, // 5 workspaces by default on every monitor
        }
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        // "format-bluetooth": "{volume}% {icon} ",
        "format-muted": "Muted ",
        "format-icons": {
            "headphone": "",
            "headset": " ",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },
    "network": {
        "interface": "enp2s0",
        "format": "{ifname}",
        "format-wifi": "{essid} {icon}",
        "fotmat-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨",
        ],
        "format-ethernet": "ethernet  ",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} {icon}",
        "tooltip-format-ethernet": "Ethernet: {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "ghostty -e nmtui",
    },
    "bluetooth": {
        "format": " {status}",
        "format-disabled": "",
        "format-connected-battery": "  {device_battery_percentage}% ",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{num_connections} connected\n{controller_alias}: {controller_address}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}: {device_address}",
        "on-click": "ghostty -e bluetuith",
    },
    "custom/wallpaper": {
        "format": " ",
        "on-click": "waypaper",
        "tooltip-format": "Change Wallpaper"
    },
    "hyprland/window": {
        "format": " {initialClass} ",
        "separate-outputs": true,
        "icon": true,
        "tooltip-format": " {initialClass} - {title} ",
    },
}
