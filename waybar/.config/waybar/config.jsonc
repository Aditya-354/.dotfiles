{
        "layer": "top",
        "modules-left": [
                "clock",
                "hyprland/window"
        ],
        "modules-right": [
                "bluetooth",
                "pulseaudio",
                "network",
                "tray"
        ],
        "modules-center": [
                "hyprland/workspaces"
        ],
        "clock": {
                "format": " {:%a, %d. %b  %H:%M} ",
                "format-alt": " {:%a, %d. %b  %H:%M} ",
                "tooltip-format": " {:%a, %d. %b  %H:%M} " 
        },
        "hyprland/workspaces": {
                "format": "{name}",
                "on-click": "activate",
                "sort-by-number": true
        },
    // ・
    "hyprland/window": {
            "format": "[{}󠁯]",
            "empty-format": "",
            "rewrite": {
                    "(.*) — Mozilla Firefox": "🌎  $1",
                    "(.*) - fish": ">  [$1]"
            },
            "separate-outputs": true
    },
    "network": {
        // "format-wifi": "{essid}  ",
        "format-wifi": "{essid}",
        "on-click": "nm-applet",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-disconnected": "No Connection", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "pulseaudio": {
            "format": "{volume}% {icon} ",
            "format-bluetooth": "{volume}% {icon}",
            "format-muted": "",
            "format-icons": {
                    "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
                    "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
                    "headphone": "",
                    "hands-free": " ",
                    "headset": "",
                    "phone": "",
                    "phone-muted": "",
                    "portable": "",
                    "car": "",
                    "default": [
                            "",
                            ""
                    ]
            },
            "scroll-step": 1,
            "on-click": "pavucontrol",
            "ignored-sinks": [
                    "Easy Effects Sink"
            ]
    },
    "bluetooth": {
            "format": " {status}",
            "format-connected": " {device_alias}",
            "format-disabled": " off",
            "on-click": "blueman-manager"
    },
    "tray": {
            "spacing": 10
    }
}
