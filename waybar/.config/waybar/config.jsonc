// 1. data / time
// 2. media
// 3. network / ethernet
// 4. bluetooth
// 5. workspaces
// 6. volume
// 7. brightness

{
    "layer": "top",
    // "modules-left": ["sway/workspaces", "sway/mode"],
    "spacing": 8,
    // "margin-top": 5,
    "modules-left": [
        "hyprland/workspaces", 
        "hyprland/window",

    ],
    "modules-center": [
        "clock", 
    ],
    "modules-right": [
        // "load",
        "memory",
        "cpu",
        "pulseaudio",
        "bluetooth",
        // "custom/wallpaper",
        "network",
    ],
    // "modules-center": [
    // ],
    "clock": {
        "interval": 1,
        "format": " {:%A %d-%m-%Y %I:%M:%S %p}",
        "tooltip": false,
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "eDP-1": 5, // 5 workspaces by default on every monitor
        }
    },
    "pulseaudio": {
        "format": " {volume}% {icon}",
        // "format-bluetooth": "{volume}% {icon} ",
        "format-muted": "Muted ",
        "format-icons": {
            "headphone": "",
            "headset": " ",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },
    "network": {
        "interface": "enp2s0",
        "interval": 1,
        "format": "{ifname} ",
        "format-wifi": "{essid} {icon}",
        "fotmat-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨",
        ],
        "format-ethernet": "ethernet  ",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} {icon}[{bandwidthDownBits} {bandwidthUpBits}]",
        "tooltip-format-ethernet": "Ethernet: {ifname}[{bandwidthDownBits} {bandwidthUpBits}]",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "ghostty -e nmtui",
    },
    "bluetooth": {
        "format": "  {status} ",
        "format-disabled": "",
        "format-connected-battery": "  {device_battery_percentage}% ",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{num_connections} connected\n{controller_alias}: {controller_address}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}: {device_address}",
        "on-click": "ghostty -e bluetuith",
    },
    "custom/wallpaper": {
        "format": " ",
        "on-click": "waypaper",
        "tooltip-format": "Change Wallpaper"
    },
    "hyprland/window": {
        "format": " {initialClass} ",
        "separate-outputs": true,
        "icon": true,
        "tooltip-format": " {title} ",
    },
    "cpu": {
        "interval": 2,
        "format": "cpu:{usage}% freq:{avg_frequency} {icon}",
        "format-icons": [
            "<span color='#69ff94'>▁</span>", // green
            "<span color='#2aa9ff'>▂</span>", // blue
            "<span color='#f8f8f2'>▃</span>", // white
            "<span color='#f8f8f2'>▄</span>", // white
            "<span color='#ffffa5'>▅</span>", // yellow
            "<span color='#ffffa5'>▆</span>", // yellow
            "<span color='#ff9977'>▇</span>", // orange
            "<span color='#dd532e'>█</span>"  // red
        ],
        "on-click": "ghostty -e bpytop -b \"cpu proc\"",
    },
    "load": {
        "interval": 1,
        "format": "load: {load1} {load5} {load15}"
    },
    "memory": {
        "interval": 30,
        // "format": "{used:0.1f}G/{total:0.1f}G "
        "format": "RAM:{}%  ",
        "on-click": "ghostty -e bpytop -b \"mem proc\"",
    },
}
